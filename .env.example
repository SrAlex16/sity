OPENAI_API_KEY=
ANTHROPIC_API_KEY=
PC_AGENT_TOKEN=change-me
SITY_ENV=development
TELEGRAM_BOT_TOKEN=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# reCAPTCHA v3 (https://www.google.com/recaptcha/admin — type: v3)
# Leave empty to run in bypass mode (dev/test) — backend always allows requests without key.
RECAPTCHA_SECRET_KEY=
RECAPTCHA_SCORE_THRESHOLD=0.5
# Web Push (VAPID) — generate once with:
#   source backend/.venv/bin/activate
#   python3 -c "from py_vapid import Vapid; v=Vapid(); v.generate_keys(); print(v.public_key.public_bytes(__import__('cryptography').hazmat.primitives.serialization.Encoding.X962,__import__('cryptography').hazmat.primitives.serialization.PublicFormat.UncompressedPoint).hex())"
# Or use pywebpush CLI: pywebpush --generate-keys
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_CONTACT=mailto:your@email.com
# Frontend — must have VITE_ prefix to be exposed to the browser build
VITE_RECAPTCHA_SITE_KEY=
