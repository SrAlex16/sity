OPENAI_API_KEY=
ANTHROPIC_API_KEY=
PC_AGENT_TOKEN=change-me
SITY_ENV=development
TELEGRAM_BOT_TOKEN=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# reCAPTCHA v3 (https://www.google.com/recaptcha/admin — type: v3)
# Leave empty to run in bypass mode (dev/test) — backend always allows requests without key.
RECAPTCHA_SECRET_KEY=
RECAPTCHA_SCORE_THRESHOLD=0.5
# Frontend — must have VITE_ prefix to be exposed to the browser build
VITE_RECAPTCHA_SITE_KEY=
