# Nota: Caddy pasa todas las cabeceras entrantes al backend por defecto, incluyendo
# CF-Connecting-IP (añadida por Cloudflare Tunnel con la IP real del visitante).
# No es necesario ningún header_up explícito para que GuestIPRateLimiter funcione.

{
    email tu_email@ejemplo.com
    acme_dns porkbun {
        api_key {env.PORKBUN_API_KEY}
        api_secret_key {env.PORKBUN_API_SECRET_KEY}
    }
}

sity.tudominio.com:443 {
    # Cabeceras de seguridad HTTP (A10 — auditoría 2026-09-16)
    # HSTS: fuerza HTTPS durante 1 año e incluye subdominios
    # X-Content-Type-Options: evita MIME-sniffing de respuestas del backend
    # X-Frame-Options: impide embeber la PWA en iframes de terceros (clickjacking)
    # Referrer-Policy: solo envía el origen en cross-site, sin path ni query
    # Permissions-Policy: bloquea acceso a cámara, micro y geolocalización desde la web
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
    }

    # SSE endpoints — flush_interval -1 disables buffering for streaming responses
    handle /chat/stream/* {
        reverse_proxy localhost:8000 {
            flush_interval -1
        }
    }
    handle /events/* {
        reverse_proxy localhost:8000 {
            flush_interval -1
        }
    }
    handle /chat/* { reverse_proxy localhost:8000 }
    handle /audio/* { reverse_proxy localhost:8000 }
    handle /auth/* { reverse_proxy localhost:8000 }
    handle /settings/* { reverse_proxy localhost:8000 }
    handle /debug/* { reverse_proxy localhost:8000 }
    handle /notifications/* { reverse_proxy localhost:8000 }
    handle /achievements* { reverse_proxy localhost:8000 }
    handle /captures* { reverse_proxy localhost:8000 }
    handle /files* { reverse_proxy localhost:8000 }
    handle /uploads* { reverse_proxy localhost:8000 }
    handle /health { reverse_proxy localhost:8000 }
    handle {
        root * /home/TU_USUARIO/projects/sity/mobile/dist
        file_server
        try_files {path} /index.html
    }
}

sity.tudominio.com:80 {
    # Cabeceras de seguridad HTTP (sin HSTS — solo aplica en HTTPS)
    header {
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
    }

    handle /chat/stream/* {
        reverse_proxy localhost:8000 {
            flush_interval -1
        }
    }
    handle /events/* {
        reverse_proxy localhost:8000 {
            flush_interval -1
        }
    }
    handle /chat/* { reverse_proxy localhost:8000 }
    handle /audio/* { reverse_proxy localhost:8000 }
    handle /auth/* { reverse_proxy localhost:8000 }
    handle /settings/* { reverse_proxy localhost:8000 }
    handle /debug/* { reverse_proxy localhost:8000 }
    handle /notifications/* { reverse_proxy localhost:8000 }
    handle /achievements* { reverse_proxy localhost:8000 }
    handle /captures* { reverse_proxy localhost:8000 }
    handle /files* { reverse_proxy localhost:8000 }
    handle /uploads* { reverse_proxy localhost:8000 }
    handle /health { reverse_proxy localhost:8000 }
    handle {
        root * /home/TU_USUARIO/projects/sity/mobile/dist
        file_server
        try_files {path} /index.html
    }
}
